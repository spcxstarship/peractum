{"book":"ad-corinthios-1","chapter":13,"verses":[{"v":1,"pairs":[["Si linguis hominum loquar,","If I were to speak in the language of men,"],["et angelorum,","or of Angels,"],["caritatem autem non habeam,","yet not have charity,"],["factus sum velut æs sonans,","I would be like a clanging bell"],["aut cymbalum tinniens.","or a crashing cymbal."]]},{"v":2,"pairs":[["Et si habuero prophetiam,","And if I have prophecy,"],["et noverim mysteria omnia,","and learn every mystery,"],["et omnem scientiam:","and obtain all knowledge,"],["et si habuero omnem fidem ita ut montes transferam,","and possess all faith, so that I could move mountains,"],["caritatem autem non habuero, nihil sum.","yet not have charity, then I am nothing."]]},{"v":3,"pairs":[["Et si distribuero in cibos pauperum omnes facultates meas,","And if I distribute all my goods in order to feed the poor,"],["et si tradidero corpus meum ita ut ardeam,","and if I hand over my body to be burned,"],["caritatem autem non habuero,","yet not have charity,"],["nihil mihi prodest.","it offers me nothing."]]},{"v":4,"pairs":[["Caritas patiens est,","Charity is patient,"],["benigna est.","is kind."],["Caritas non æmulatur,","Charity does not envy,"],["non agit perperam,","does not act wrongly,"],["non inflatur,","is not inflated."]]},{"v":5,"pairs":[["non est ambitiosa,","Charity is not ambitious,"],["non quærit quæ sua sunt,","does not seek for itself,"],["non irritatur,","is not provoked to anger,"],["non cogitat malum,","devises no evil."]]},{"v":6,"pairs":[["non gaudet super iniquitate,","Charity does not rejoice over iniquity,"],["congaudet autem veritati:","but rejoices in truth."]]},{"v":7,"pairs":[["omnia suffert,","Charity suffers all,"],["omnia credit,","believes all,"],["omnia sperat,","hopes all,"],["omnia sustinet.","endures all."]]},{"v":8,"pairs":[["Caritas numquam excidit:","Charity is never torn away,"],["sive prophetiæ evacuabuntur,","even if prophecies pass away,"],["sive linguæ cessabunt,","or languages cease,"],["sive scientia destruetur.","or knowledge is destroyed."]]},{"v":9,"pairs":[["Ex parte enim cognoscimus,","For we know only in part,"],["et ex parte prophetamus.","and we prophesy only in part."]]},{"v":10,"pairs":[["Cum autem venerit quod perfectum est,","But when the perfect arrives,"],["evacuabitur quod ex parte est.","the imperfect passes away."]]},{"v":11,"pairs":[["Cum essem parvulus,","When I was a child,"],["loquebar ut parvulus,","I spoke like a child,"],["sapiebam ut parvulus,","I understood like a child,"],["cogitabam ut parvulus.","I thought like a child."],["Quando autem factus sum vir,","But when I became a man,"],["evacuavi quæ erant parvuli.","I put aside the things of a child."]]},{"v":12,"pairs":[["Videmus nunc per speculum in ænigmate:","Now we see through a glass darkly."],["tunc autem facie ad faciem.","But then we shall see face to face."],["Nunc cognosco ex parte:","Now I know in part,"],["tunc autem cognoscam sicut","but then I shall know,"],["et cognitus sum.","even as I am known."]]},{"v":13,"pairs":[["Nunc autem manent fides, spes,","But for now, these three continue:"],["caritas,","faith, hope,"],["tria hæc:","and charity."],["major autem horum est caritas.","And the greatest of these is charity."]]}]}