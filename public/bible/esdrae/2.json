ns of Sophereth,"],["filii Pharuda,","the sons of Peruda,"]]},{"v":56,"pairs":[["filii Jala,","the sons of Jaalah,"],["filii Dercon,","the sons of Darkon,"],["filii Geddel,","the sons of Giddel,"]]},{"v":57,"pairs":[["filii Saphatia,","the sons of Shephatiah,"],["filii Hatil,","the sons of Hattil,"],["filii Phochereth,","the sons of Pochereth,"],["qui erant de Asebaim,","who were of Hazzebaim,"],["filii Ami:","the sons of Ami:"]]},{"v":58,"pairs":[["omnes Nathinæi,","all the temple servants"],["et filii servorum Salomonis,","and the sons of the servants of Solomon,"],["trecenti nonaginta duo.","three hundred ninety-two."]]},{"v":59,"pairs":[["Et hi qui ascenderunt de Thelmala,","And these were the ones who ascended from Telmelah,"],["Thelharsa,","Telharsha,"],["Cherub,","Cherub,"],["et Adon,","and Addan,"],["et Emer:","and Immer."],["et non potuerunt indicare domum patrum suorum et semen suum,","And they were not able to indicate the house of their fathers and their offspring,"],["utrum ex Israël essent.","whether they were of Israel:"]]},{"v":60,"pairs":[["Filii Dalaia,","The sons of Delaiah,"],["filii Tobia,","the sons of Tobiah,"],["filii Necoda,","the sons of Nekoda,"],["sexcenti quinquaginta duo.","six hundred fifty-two."]]},{"v":61,"pairs":[["Et de filiis sacerdotum:","And from the sons of the priests:"],["filii Hobia,","the sons of Hobaiah,"],["filii Accos,","the sons of Hakkoz,"],["filii Berzellai,","the sons of Barzillai,"],["qui accepit de filiabus Berzellai Galaaditis,","who took a wife from the daughters of Barzillai,"],["uxorem,","the Gileadite,"],["et vocatus est nomine eorum:","and who were called by their name."]]},{"v":62,"pairs":[["hi quæsierunt scripturam genealogiæ suæ,","These sought the writing of their genealogy,"],["et non invenerunt,","and they did not find it,"],["et ejecti sunt de sacerdotio.","and so they were cast out of the priesthood."]]},{"v":63,"pairs":[["Et dixit Athersatha eis ut non comederent de Sancto sanctorum,","And the cupbearer said to them that they should not eat from the Holy of Holies,"],["donec surgeret sacerdos doctus","until there would arise a priest,"],["atque perfectus.","learned and perfect."]]},{"v":64,"pairs":[["Omnis multitudo quasi unus, quadraginta duo millia trecenti sexaginta:","The entire multitude joined together was forty-two thousand three hundred sixty,"]]},{"v":65,"pairs":[["exceptis servis eorum,","not including their men and women servants,"],["et ancillis,","of whom there were seven thousand three hundred thirty-seven."],["qui erant septem millia trecenti triginta septem:","And among these were singing men and singing women,"],["et in ipsis cantores atque cantatrices ducenti.","two hundred."]]},{"v":66,"pairs":[["Equi eorum septingenti triginta sex,","Their horses were seven hundred thirty-six;"],["muli eorum, ducenti quadraginta quinque,","their mules were two hundred forty-five;"]]},{"v":67,"pairs":[["cameli eorum, quadringenti triginta quinque,","their camels were four hundred thirty-five;"],["asini eorum, sex millia septingenti viginti.","their donkeys were six thousand seven hundred twenty."]]},{"v":68,"pairs":[["Et de principibus patrum,","And some of the leaders among the fathers,"],["cum ingrederentur templum Domini,","when they entered into the temple of the Lord,"],["quod est in Jerusalem,","which is in Jerusalem,"],["sponte obtulerunt in domum Dei ad exstruendam eam in loco suo.","freely offered some of these to the house of God, in order to construct it in its location."]]},{"v":69,"pairs":[["Secundum vires suas dederunt impensas operis,","They gave to the expenses of the work in accord with their ability:"],["auri solidos sexaginta millia et mille,","sixty-one thousand gold coins,"],["argenti mnas quinque millia,","five thousand silver minas,"],["et vestes sacerdotales centum.","and one hundred priestly vestments."]]},{"v":70,"pairs":[["Habitaverunt ergo sacerdotes,","Therefore,"],["et Levitæ,","the priests"],["et de populo,","and the Levites,"],