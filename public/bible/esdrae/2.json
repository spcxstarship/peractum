{"book":"esdrae","chapter":2,"verses":[{"v":1,"pairs":[["Hi sunt autem provinciæ filii,","Now these are the sons of the province,"],["qui ascenderunt de captivitate,","who ascended from the captivity,"],["quam transtulerat Nabuchodonosor rex Babylonis in Babylonem,","whom Nebuchadnezzar, king of Babylon, had transferred to Babylon,"],["et reversi sunt in Jerusalem et Judam, unusquisque in civitatem suam.","and who were returned to Jerusalem and to Judah, each one to his own city."]]},{"v":2,"pairs":[["Qui venerunt cum Zorobabel,","They arrived with Zerubbabel,"],["Josue,","Jeshua,"],["Nehemia,","Nehemiah,"],["Saraia,","Seraiah,"],["Rahelaia,","Reelaiah,"],["Mardochai,","Mordecai,"],["Belsan,","Bilshan,"],["Mesphar,","Mispar,"],["Beguai,","Bigvai,"],["Rehum,","Rehum,"],["Baana.","Baanah."],["Numerus virorum populi Israël:","The number of the men of the people of Israel:"]]},{"v":3,"pairs":[["filii Pharos duo millia centum septuaginta duo.","The sons of Parosh, two thousand one hundred seventy-two."]]},{"v":4,"pairs":[["Filii Sephatia,","The sons of Shephatiah,"],["trecenti septuaginta duo.","three hundred seventy-two."]]},{"v":5,"pairs":[["Filii Area,","The sons of Arah,"],["septingenti septuaginta quinque.","seven hundred seventy-five."]]},{"v":6,"pairs":[["Filii Phahath Moab,","The sons of Pahath-moab,"],["filiorum Josue:","of the sons of Jeshua"],["Joab,","and Joab,"],["duo millia octingenti duodecim.","two thousand eight hundred twelve."]]},{"v":7,"pairs":[["Filii Ælam,","The sons of Elam,"],["mille ducenti quinquaginta quatuor.","one thousand two hundred fifty-four."]]},{"v":8,"pairs":[["Filii Zethua,","The sons of Zattu,"],["nongenti quadraginta quinque.","nine hundred forty-five."]]},{"v":9,"pairs":[["Filii Zachai,","The sons of Zaccai,"],["septingenti sexaginta.","seven hundred sixty."]]},{"v":10,"pairs":[["Filii Bani,","The sons of Bani,"],["sexcenti quadraginta duo.","six hundred forty-two."]]},{"v":11,"pairs":[["Filii Bebai,","The sons of Bebai,"],["sexcen