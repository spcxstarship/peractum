{"book":"psalmi","chapter":133,"verses":[{"v":1,"pairs":[["Canticum graduum.","A Canticle in steps."],["Ecce nunc benedicite Dominum,","Behold, bless the Lord now,"],["omnes servi Domini:","all you servants of the Lord,"],["qui statis in domo Domini,","who stand in the house of the Lord,"],["in atriis domus Dei nostri.","in the courts of the house of our God."]]},{"v":2,"pairs":[["In noctibus extollite manus vestras in sancta,","In the nights, lift up your hands in sanctity,"],["et benedicite Dominum.","and bless the Lord."]]},{"v":3,"pairs":[["Benedicat te Dominus ex Sion,","May the Lord,"],["qui fecit cælum","who made heaven and earth,"],["et terram.","bless you from Zion."]]}]}