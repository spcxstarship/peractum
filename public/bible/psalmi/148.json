{"book":"psalmi","chapter":148,"verses":[{"v":1,"pairs":[["Alleluja.","Alleluia."],["Laudate Dominum de cælis;","Praise the Lord from the heavens."],["laudate eum in excelsis.","Praise him on the heights."]]},{"v":2,"pairs":[["Laudate eum,","Praise him,"],["omnes angeli ejus;","all his Angels."],["laudate eum,","Praise him,"],["omnes virtutes ejus.","all his hosts."]]},{"v":3,"pairs":[["Laudate eum,","Praise him,"],["sol et luna;","sun and moon."],["laudate eum,","Praise him,"],["omnes stellæ et lumen.","all stars and light."]]},{"v":4,"pairs":[["Laudate eum,","Praise him,"],["cæli cælorum;","heavens of the heavens."],["et aquæ omnes quæ super cælos sunt,","And let all the waters that are above the heavens"]]},{"v":5,"pairs":[["laudent nomen Domini.","praise the name of the Lord."],["Quia ipse dixit,","For he spoke,"],["et facta sunt;","and they became."],["ipse mandavit,","He commanded,"],["et creata sunt.","and they were created."]]},{"v":6,"pairs":[["Statuit ea in æternum,","He has stationed them in eternity,"],["et in sæculum sæculi;","and for age after age."],["præceptum posuit,","He has established a precept,"],["et non præteribit.","and it will not pass away."]]},{"v":7,"pairs":[["Laudate Dominum de terra,","Praise the Lord from the earth:"],["dracones et omnes abyssi;","you dragons and all deep places,"]]},{"v":8,"pairs":[["ignis,","fire,"],["grando,","hail,"],["nix,","snow,"],["glacies,","ice,"],["spiritus procellarum,","windstorms,"],["quæ faciunt verbum ejus;","which do his word,"]]},{"v":9,"pairs":[["montes,","mountains"],["et omnes colles;","and all hills,"],["ligna fructifera,","fruitful trees"],["et omnes cedri;","and all cedars,"]]},{"v":10,"pairs":[["bestiæ,","wild beasts"],["et universa pecora;","and all cattle,"],["serpentes,","serpents"],["et volucres pennatæ;","and feathered flying things,"]]},{"v":11,"pairs":[["reges terræ et omnes populi;","kings of the earth and all peoples,"],["principes et omnes judices terræ;","leaders and all judges of the earth,"]]},{"v":12,"pairs":[["juvenes et virgines;","young men and virgins."],["senes cum junioribus,","Let the older men with the younger men,"],["laudent nomen Domini:","praise the name of the Lord."]]},{"v":13,"pairs":[["quia exaltatum est nomen ejus solius.","For his name alone is exalted."]]},{"v":14,"pairs":[["Confessio ejus super cælum et terram;","Confession of him is beyond heaven and earth,"],["et exaltavit cornu populi sui.","and he has exalted the horn of his people."],["Hymnus omnibus sanctis ejus;","A hymn to all his holy ones,"],["filiis Israël,","to the sons of Israel,"],["populo appropinquanti sibi.","to a people close to him."],["Alleluja.","Alleluia."]]}]}