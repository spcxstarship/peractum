n of the other Nebo,"],["quinquaginta duo.","fifty-two."]]},{"v":34,"pairs":[["Viri Ælam alterius,","The men of the other Elam,"],["mille ducenti quinquaginta quatuor.","one thousand two hundred fifty-four."]]},{"v":35,"pairs":[["Filii Harem,","The sons of Harim,"],["trecenti viginti.","three hundred twenty."]]},{"v":36,"pairs":[["Filii Jericho,","The sons of Jericho,"],["trecenti quadraginta quinque.","three hundred forty-five."]]},{"v":37,"pairs":[["Filii Lod Hadid et Ono,","The sons of Lod, Hadid, and Ono,"],["septingenti viginti unus.","seven hundred twenty-one."]]},{"v":38,"pairs":[["Filii Senaa,","The sons of Senaah,"],["tria millia nongenti triginta.","three thousand nine hundred thirty."]]},{"v":39,"pairs":[["Sacerdotes:","The priests:"],["filii Idaia in domo Josue,","the sons of Jedaiah in the house of Jeshua,"],["nongenti septuaginta tres.","nine hundred seventy-three."]]},{"v":40,"pairs":[["Filii Emmer,","The sons of Immer,"],["mille quinquaginta duo.","one thousand fifty-two."]]},{"v":41,"pairs":[["Filii Phashur,","The sons of Pashhur,"],["mille ducenti quadraginta septem.","one thousand two hundred forty-seven."]]},{"v":42,"pairs":[["Filii Arem,","The sons of Harim,"],["mille decem et septem.","one thousand"],["Levitæ:","and seventeen."]]},{"v":43,"pairs":[["filii Josue et Cedmihel filiorum","The Levites: the sons of Jeshua and Kadmiel, the sons"]]},{"v":44,"pairs":[["Oduiæ,","of Hodaviah,"],["septuaginta quatuor.","seventy-four."],["Cantores:","The singing men:"]]},{"v":45,"pairs":[["filii Asaph,","the sons of Asaph,"],["centum quadraginta octo.","one hundred forty-eight."]]},{"v":46,"pairs":[["Janitores:","The gatekeepers:"],["filii Sellum,","the sons of Shallum,"],["filii Ater,","the sons of Ater,"],["filii Telmon,","the sons of Talmon,"],["filii Accub,","the sons of Akkub,"],["filii Hatita,","the sons of Hatita,"],["filii Sobai:","the sons of Shobai,"],["centum triginta octo.","one hundred thirty-eight."]]},{"v":47,"pairs":[["Nathinæi:","The temple servants:"],["filii Soha,","the sons of Ziha,"],["filii Hasupha,","the sons of Hasupha,"],["filii Tebbaoth,","the sons of Tabbaoth,"]]},{"v":48,"pairs":[["filii Ceros,","the sons of Keros,"],["filii Siaa,","the sons of Siaha,"],["filii Phadon,","the sons of Padon,"],["filii Lebana,","the sons of Lebanah,"],["filii Hagaba,","the sons of Hagabah,"],["filii Selmai,","the sons of Shalmai,"]]},{"v":49,"pairs":[["filii Hanan,","the sons of Hanan,"],["filii Geddel,","the sons of Giddel,"],["filii Gaher,","the sons of Gahar,"]]},{"v":50,"pairs":[["filii Raaia,","the sons of Reaiah,"],["filii Rasin,","the sons of Rezin,"],["filii Necoda,","the sons of Nekoda,"]]},{"v":51,"pairs":[["filii Gezem,","the sons of Gazzam,"],["filii Aza,","the sons of Uzza,"],["filii Phasea,","the sons of Paseah,"]]},{"v":52,"pairs":[["filii Besai,","the sons of Besai,"],["filii Munim,","the sons of Meunim,"],["filii Nephussim,","the sons of Nephusim,"]]},{"v":53,"pairs":[["filii Bacbuc,","the sons of Bakbuk,"],["filii Hacupha,","the sons of Hakupha,"],["filii Harhur,","the sons of Harhur,"]]},{"v":54,"pairs":[["filii Besloth,","the sons of Bazluth,"],["filii Mahida,","the sons of Mehida,"],["filii Harsa,","the sons of Harsha,"]]},{"v":55,"pairs":[["filii Bercos,","the sons of Barkos,"],["filii Sisara,","the sons of Sisera,"],["filii Thema,","the sons of Temah,"]]},{"v":56,"pairs":[["filii Nasia,","the sons of Neziah,"],["filii Hatipha,","the sons of Hatipha."]]},{"v":57,"pairs":[["filii servorum Salomonis,","The sons of the servants of Solomon:"],["filii Sothai,","the sons of Sotai,"],["filii Sophereth,","the sons of Sophereth,"],["filii Pharida,","the sons of Perida,"]]},{"v":58,"pairs":[["filii Jahala,","the sons of Jaalah,"],["filii Darcon,","the sons of Darkon,"],["filii Jeddel,","the sons of Giddel,"]]},{"v":59,"pairs":[["filii Saphatia,","the sons of Shephatiah,"],["filii Hatil,","the sons of Hattil,"],["filii Phochereth,","the sons of Pochereth,"],["qui erat ortus ex Sabaim filio Amon.","who was born from Hazzebaim, the son of Amon."]]},{"v":60,"pairs":[["Omnes Nathinæi,","All the temple servants"],["et filii servorum Salomonis,","and the sons of the servants of Solomon,"],["trecenti nonaginta duo.","three hundred ninety-two."]]},{"v":61,"pairs":[["Hi sunt autem qui ascenderunt de Thelmela,","Now these are the ones who ascended from Telmelah,"],["Thelharsa,","Telharsha,"],["Cherub,","Cherub,"],["Addon,","Addon,"],["et Emmer:","and Immer;"],["et non potuerunt indicare domum patrum suorum,","and they were not able to indicate the house of their fathers"],["et semen suum,","and their offspring,"],["utrum ex Israël essent,","whether they were of Israel:"]]},{"v":62,"pairs":[["filii Dalaia,","the sons of Delaiah,"],["filii Tobia,","the sons of Tobiah,"],["filii Necoda,","the sons of Nekoda,"],["sexcenti quadraginta duo.","six hundred forty-two;"]]},{"v":63,"pairs":[["Et de sacerdotibus,","and among the priests:"],["filii Habia,","the sons of Hobaiah,"],["filii Accos,","the sons of Hakkoz,"],["filii Berzellai,","the sons of Barzillai,"],["qui accepit de filiabus Berzellai Galaaditis uxorem,","who took a wife from the daughters of Barzillai, a Gileadite,"],["et vocatus est nomine eorum.","and he was called by their name."]]},{"v":64,"pairs":[["Hi quæsierunt scripturam suam in censu,","These sought their writing in the census,"],["et non invenerunt:","and they did not find it,"],["et ejecti sunt de sacerdotio.","and so they were cast out of the priesthood."]]},{"v":65,"pairs":[["Dixitque Athersatha eis ut non manducarent de Sanctis sanctorum,","And the cupbearer said to them that they should not eat from the Holy of Holies,"],["donec staret sacerdos doctus et eruditus.","until a priest would stand up who was learned and skillful."]]},{"v":66,"pairs":[["Omnis multitudo quasi vir unus quadraginta duo millia trecenti sexaginta,","The entire multitude, which was like one man, was forty-two thousand three hundred sixty,"]]},{"v":67,"pairs":[["absque servis et ancillis eorum,","aside from their men and women servants,"],["qui erant septem millia trecenti triginta septem,","who were seven thousand three hundred thirty-seven,"],["et inter eos cantores et cantatrices,","and among them were singing men and singing women,"],["ducenti quadraginta quinque.","two hundred forty-five."]]},{"v":68,"pairs":[["Equi eorum, septingenti triginta sex:","Their horses were seven hundred thirty-six;"],["muli eorum, ducenti quadraginta quinque:","their mules were two hundred forty-five."]]},{"v":69,"pairs":[["cameli eorum, quadringenti triginta quinque:","Their camels were four hundred thirty-five;"],["asini, sex millia septingenti viginti.","their donkeys were six thousand seven hundred twenty."]]},{"v":70,"pairs":[["Nonnulli autem de principibus familiarum dederunt in opus.","Now several of the leaders of the families gave to the work."],["Athersatha dedit in thesaurum auri drachmas mille,","The cupbearer gave to the treasury one thousand drachmas of gold,"],["phialas quinquaginta,","fifty bowls,"],["tunicas sacerdotales quingentas triginta.","and five hundred thirty priestly garments."]]},{"v":71,"pairs":[["Et de principibus familiarum dederunt in thesaurum operis, auri drachmas viginti millia,","And some of the leaders of the families gave to the treasury of the work twenty thousand drachmas of gold,"],["et argenti mnas duo millia ducentas.","and two thousand two hundred minas of silver."]]},{"v":72,"pairs":[["Et quod dedit reliquus populus, auri drachmas viginti millia,","And what the remainder of the people gave was twenty thousand drachmas of gold,"],["et argenti mnas duo millia,","and two thousand minas of silver,"],["et tunicas sacerdotales sexaginta septem.","and sixty-seven priestly garments."]]},{"v":73,"pairs":[["Habitaverunt autem sacerdotes,","Now the priests, and the Levites,"],["et Levitæ,","and the gatekeepers,"],["et janitores,","and the singing men,"],["et cantores, et reliquum vulgus,","and the rest of the common people,"],["et Nathinæi,","and the temple servants,"],["et omnis Israël, in civitatibus suis.","and all of Israel dwelt in their own cities."]]}]}