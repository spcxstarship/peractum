{"book":"nehemiae","chapter":7,"verses":[{"v":1,"pairs":[["Postquam autem ædificatus est murus,","Then, after the wall was built,"],["et posui valvas,","and I set up the double doors,"],["et recensui janitores,","and I enrolled the gatekeepers,"],["et cantores,","and the singing men,"],["et Levitas,","and the Levites,"]]},{"v":2,"pairs":[["præcepi Hanani fratri meo, et Hananiæ principi domus de Jerusalem (ipse enim quasi vir verax et timens Deum plus ceteris videbatur),","I instructed Hanani, my brother, and Hananiah, the leader of the house of Jerusalem, (for he seemed to be a truthful man, fearing God more than the others,)"]]},{"v":3,"pairs":[["et dixi eis:","and I said to them:"],["Non aperiantur portæ Jerusalem usque ad calorem solis.","“Let not the gates of Jerusalem be opened until the sun is hot.”"],["Cumque adhuc assisterent,","And while they were standing there,"],["clausæ portæ sunt,","the gates were closed"],["et oppilatæ:","and barred."],["et posui custodes de habitatoribus Jerusalem,","And I stationed guards from the inhabitants of Jerusalem,"],["singulos per vices suas,","each one in his turn,"],["et unumquemque contra domum suam.","and each one opposite his own house."]]},{"v":4,"pairs":[["Civitas autem erat lata nimis et grandis,","Now the city was great and very wide,"],["et populus parvus in medio ejus,","and the people in its midst were few,"],["et non erant domus ædificatæ.","and the houses were not yet built."]]},{"v":5,"pairs":[["Deus autem dedit in corde meo,","But God had given to my heart,"],["et congregavi optimates,","and I gathered the nobles,"],["et magistratus,","and the magistrates,"],["et vulgus,","and the common people,"],["ut recenserem eos:","so that I might enroll them."],["et inveni librum census eorum qui ascenderant primum,","And I found a book of the census of those who first went up,"],["et inventum est scriptum in eo.","and in it there was found written:"]]},{"v":6,"pairs":[["Isti filii provinciæ,","These are the sons of the province,"],["qui ascenderunt de captivitate migrantium,","who ascended from the captivity of the transmigration,"],["quos transtulerat Nabuchodonosor rex Babylonis,","those whom Nebuchadnezzar, the king of Babylon, had taken away,"],["et reversi sunt in Jerusalem et in Judæam,","and who returned into Jerusalem and Judea,"],["unusquisque in civitatem suam.","each one to his own city."]]},{"v":7,"pairs":[["Qui venerunt cum Zorobabel,","They arrived with Zerubbabel,"],["Josue,","Jeshua,"],["Nehemias,","Nehemiah,"],["Azarias,","Azariah,"],["Raamias,","Raamiah,"],["Nahamani,","Nahamani,"],["Mardochæus,","Mordecai,"],["Belsam,","Bilshan,"],["Mespharath,","Mispereth,"],["Begoai,","Bigvai,"],["Nahum,","Nehum,"],["Baana.","Baanah."],["Numerus virorum populi Israël:","The number of the men of the people of Israel:"]]},{"v":8,"pairs":[["filii Pharos,","The sons of Parosh,"],["duo millia centum septuaginta duo:","two thousand one hundred seventy-two."]]},{"v":9,"pairs":[["filii Saphatia,","The sons of Shephatiah,"],["trecenti septuaginta duo:","three hundred seventy-two."]]},{"v":10,"pairs":[["filii Area,","The sons of Arah,"],["sexcenti quinquaginta duo:","six hundred fifty-two."]]},{"v":11,"pairs":[["filii Phahathmoab filiorum Josue et Joab,","The sons of Pahath-moab of the sons of Jeshua and of Joab,"],["duo millia octingenti decem et octo:","two thousand eight hundred eighteen."]]},{"v":12,"pairs":[["filii Ælam,","The sons of Elam,"],["mille ducenti quinquaginta quatuor:","one thousand two hundred fifty-four."]]},{"v":13,"pairs":[["filii Zethua,","The sons of Zattu,"],["octingenti quadraginta quinque:","eight hundred forty-five."]]},{"v":14,"pairs":[["filii Zachai,","The sons of Zaccai,"],["septingenti sexaginta:","seven hundred sixty."]]},{"v":15,"pairs":[["filii Bannui,","The sons of Binnui,"],["sexcenti quadraginta octo:","six hundred forty-eight."]]},{"v":16,"pairs":[["filii Bebai,","The sons of Bebai,"],["sexcenti viginti octo:","six hundred twenty-eight."]]},{"v":1