{"book":"paralipomenon-1","chapter":1,"verses":[{"v":1,"pairs":[["Adam,","Adam,"],["Seth,","Seth,"],["Enos,","Enos,"]]},{"v":2,"pairs":[["Cainan,","Cainan,"],["Malaleel,","Mahalalel,"],["Jared,","Jared,"]]},{"v":3,"pairs":[["Henoch,","Enoch,"],["Mathusale,","Methuselah,"],["Lamech,","Lamech,"]]},{"v":4,"pairs":[["Noë,","Noah,"],["Sem,","Shem,"],["Cham,","Ham,"],["et Japtheth.","and Japheth."]]},{"v":5,"pairs":[["Filii Japheth:","The sons of Japheth:"],["Gomer,","Gomer,"],["et Magog,","and Magog,"],["et Madai,","and Madai,"],["et Javan,","and Javan,"],["Thubal,","Tubal,"],["Mosoch,","Meshech,"],["Thiras.","Tiras."]]},{"v":6,"pairs":[["Porro filii Gomer:","And the sons of Gomer:"],["Ascenez,","Ashkenaz,"],["et Riphath,","and Riphath,"],["et Thogorma.","and Togarmah."]]},{"v":7,"pairs":[["Filii autem Javan:","And the sons of Javan:"],["Elisa et Tharsis,","Elishah and Tarshish,"],["Cethim et Dodanim.","Kittim and Rodanim."]]},{"v":8,"pairs":[["Filii Cham:","The sons of Ham:"],["Chus,","Cush,"],["et Mesraim,","and Mizraim,"],["et Phut,","and Put,"],["et Chanaan.","and Canaan."]]},{"v":9,"pairs":[["Filii autem Chus:","And the sons of Cush:"],["Saba,","Seba,"],["et Hevila,","and Havilah,"],["Sabatha,","Sabtah,"],["et Regma,","and Raamah,"],["et Sabathacha.","and Sabteca."],["Porro filii Regma:","And the sons of Raamah:"],["Saba,","Sheba"],["et Dadan.","and Dadan."]]},{"v":10,"pairs":[["Chus autem genuit Nemrod:","Then Cush conceived Nimrod,"],["iste cœpit esse potens in terra.","and he began to be powerful upon the earth."]]},{"v":11,"pairs":[["Mesraim vero genuit Ludim,","Truly, Mizraim conceived Ludim,"],["et Anamim,","and Anamim,"],["et Laabim,","and Lehabim,"],["et Nephtuim,","and Naphtuhim,"]]},{"v":12,"pairs":[["Phetrusim quoque,","as well as Pathrusim"],["et Casluim:","and Casluhim:"],["de quibus egressi sunt Philisthiim,","from these the Philistines"],["et Caphtorim.","and the Caphtorim went forth."]]},{"v":13,"pairs":[["Chanaan vero genuit Sidonem primogenitum suum,","Truly, Canaan conceived Sidon, his firstborn,"],["Hethæum quoque,","as well as the Hittite,"]]},{"v":14,"pairs":[["et Jebusæum,","and the Jebusite,"],["et Amorrhæum,","and the Amorite,"],["et Gergesæum,","and the Girgashite,"]]},{"v":15,"pairs":[["Hevæumque","and the Hivite,"],["et Aracæum,","and the Arkite,"],["et Sinæum.","and the Sinite,"]]},{"v":16,"pairs":[["Aradium quoque,","and also the Arvadian,"],["et Samaræum,","and the Samarite,"],["et Hamathæum.","and the Hamathite."]]},{"v":17,"pairs":[["Filii Sem:","The sons of Shem:"],["Ælam,","Elam,"],["et Assur,","and Asshur,"],["et Arphaxad,","and Arphaxad,"],["et Lud,","and Lud,"],["et Aram,","and Aram,"],["et Hus,","and Uz,"],["et Hul,","and Hul,"],["et Gether,","and Gether,"],["et Mosoch.","and Meshech."]]},{"v":18,"pairs":[["Arphaxad autem genuit Sale,","Then Arphaxad conceived Shelah,"],["qui et ipse genuit Heber.","who also himself conceived Eber."]]},{"v":19,"pairs":[["Porro Heber nati sunt duo filii:","And to Eber were born two sons."],["nomen uni Phaleg,","The name of one was Peleg,"],["quia in diebus ejus divisa est terra;","because in his days the earth was divided."],["et nomen fratris ejus Jectan.","And the name of his brother was Joktan."]]},{"v":20,"pairs":[["Jectan autem genuit Elmodad,","Then Joktan conceived Almodad,"],["et Saleph,","and Sheleph,"],["et Asarmoth,","and Hazarmaveth,"],["et Jare,","and Jerah,"]]},{"v":21,"pairs":[["Adoram quoque,","as well as Hadoram,"],["et Huzal,","and Uzal,"],["et Decla,","and Diklah,"]]},{"v":22,"pairs":[["Hebal etiam,","and then Obal,"],["et Abimaël,","and Abimael,"],["et Saba,","and Sheba,"],["necnon","indeed"]]},{"v":23,"pairs":[["et Ophir,","also Ophir,"],["et Hevila,","and Havilah,"],["et Jobab:","and Jobab."],["omnes isti filii Jectan.","All these are the sons of Joktan."]]},{"v":24,"pairs":[["Sem,","Shem,"],["Arphaxad,","Arphaxad,"],["Sale,","Shelah,"]]},{"v":25,"pairs":[["Heber,","Eber,"],["Phaleg,","Peleg,"],["Ragau,","Reu,"]]},{"v":26,"pairs":[["Serug,","Serug,"],["Nachor,","Nahor,"],["Thare,","Terah,"]]},{"v":27,"pairs":[["Abram:","Abram,"],["iste est Abraham.","the same is Abraham."]]},{"v":28,"pairs":[["Filii autem Abraham,","And the sons of Abraham:"],["Isaac et Ismahel.","Isaac and Ishmael."]]},{"v":29,"pairs":[["Et hæ generationes eorum.","And these are their generations:"],["Primogenitus Ismahelis,","the firstborn of Ishmael,"],["Nabaioth,","Nebaioth,"],["et Cedar,","and then Kedar,"],["et Adbeel,","and Adbeel,"],["et Mabsam,","and Mibsam,"]]},{"v":30,"pairs":[["et Masma,","and Mishma,"],["et Duma,","and Dumah,"],["Massa,","Massa,"],["Hadad,","Hadad,"],["et Thema,","and Tema,"]]},{"v":31,"pairs":[["Jetur,","Jetur,"],["Naphis,","Naphish,"],["Cedma:","Kedemah."],["hi sunt filii Ismahelis.","These are the sons of Ishmael."]]},{"v":32,"pairs":[["Filii autem Ceturæ concubinæ Abraham,","And the sons of Keturah,"],["quos genuit:","the concubine of Abraham,"],["Zamran,","whom she conceived:"],["Jecsan,","Zimran,"],["Madan,","Jokshan,"],["Madian,","Medan,"],["Jesboc,","Midian,"],["et Sue.","Ishbak,"],["Porro filii Jecsan:","and Shuah."],["Saba,","And the sons of Jokshan:"],["et Dadan.","Sheba and Dedan."],["Filii autem Dadan:","And the sons of Dedan:"],["Assurim,","Asshurim,"],["et Latussim,","and Letushim,"],["et Laomim.","and Leummim."]]},{"v":33,"pairs":[["Filii autem Madian:","And the sons of Midian:"],["Epha,","Ephah,"],["et Epher,","and Epher,"],["et Henoch,","and Hanoch,"],["et Abida,","and Abida,"],["et Eldaa:","and Eldaah."],["omnes hi filii Ceturæ.","All these are the sons of Keturah."]]},{"v":34,"pairs":[["Genuit autem Abraham Isaac:","Now Abraham conceived Isaac,"],["cujus fuerunt filii Esau,","whose sons were Esau"],["et Israël.","and Israel."]]},{"v":35,"pairs":[["Filii Esau:","The sons of Esau:"],["Eliphaz,","Eliphaz,"],["Rahuel,","Reuel,"],["Jehus,","Jeush,"],["Ihelom,","Jalam,"],["et Core.","and Korah."]]},{"v":36,"pairs":[["Filii Eliphaz:","The sons of Eliphaz:"],["Theman,","Teman,"],["Omar,","Omar,"],["Sephi,","Zepho,"],["Gathan,","Gatam,"],["Cenez,","Kenez,"],["Thamna,","and by Timna,"],["Amalec.","Amalek."]]},{"v":37,"pairs":[["Filii Rahuel:","The sons of Reuel:"],["Nahath,","Nahath,"],["Zara,","Zerah,"],["Samma,","Shammah,"],["Meza.","Mizzah."]]},{"v":38,"pairs":[["Filii Seir:","The sons of Seir:"],["Lotan,","Lotan,"],["Sobal,","Shobal,"],["Sebeon,","Zibeon,"],["Ana,","Anah,"],["Dison,","Dishon,"],["Eser,","Ezer,"],["Disan.","Dishan."]]},{"v":39,"pairs":[["Filii Lotan:","The sons of Lotan:"],["Hori,","Hori,"],["Homam.","Heman."],["Soror autem Lotan fuit Thamna.","Now the sister of Lotan was Timna."]]},{"v":40,"pairs":[["Filii Sobal: Alian,","The sons of Shobal: Alian,"],["et Manahath,","and Manahath,"],["et Ebal,","and Ebal,"],["Sephi et Onam.","Shephi, and Onam."],["Filii Sebeon:","The sons of Zibeon:"],["Aja et Ana.","Aiah and Anah."],["Filii Ana:","The sons of Anah:"],["Dison.","Dishon."]]},{"v":41,"pairs":[["Filii Dison:","The sons of Dishon:"],["Hamram,","Hamran,"],["et Heseban,","and Esheban,"],["et Jethran,","and Ithran,"],["et Charan.","and Cheran."]]},{"v":42,"pairs":[["Filii Eser:","The sons of Ezer:"],["Balaan,","Bilhan,"],["et Zavan,","and Zaavan,"],["et Jacan.","and Akan."],["Filii Disan:","The sons of Dishan:"],["Hus et Aran.","Uz and Aran."]]},{"v":43,"pairs":[["Isti sunt reges qui imperaverunt in terra Edom,","Now these are the kings who reigned in the land of Edom,"],["antequam esset rex super filios Israël.","before there was a king over the sons of Israel:"],["Bale filius Beor:","Bela,"],["et nomen civitatis ejus,","the son of Beor;"],["Denaba.","and the name of his city was Dinhabah."]]},{"v":44,"pairs":[["Mortuus est autem Bale,","Then Bela died, and Jobab,"],["et regnavit pro eo Jobab filius Zare de Bosra.","the son of Zerah, from Bozrah, reigned in his place."]]},{"v":45,"pairs":[["Cumque et Jobab fuisset mortuus,","And when Jobab also had died, Husham,"],["regnavit pro eo Husam de terra Themanorum.","from the land of the Temanites, reigned in his place."]]},{"v":46,"pairs":[["Obiit quoque et Husam,","Then Husham also passed away,"],["et regnavit pro eo Adad filius Badad,","and Hadad, the son of Bedad, reigned in his place."],["qui percussit Madian in terra Moab:","And he struck the Midianites in the land of Moab."],["et nomen civitatis ejus Avith.","The name of his city was Avith."]]},{"v":47,"pairs":[["Cumque et Adad fuisset mortuus,","And when Hadad also had died,"],["regnavit pro eo Semla de Masreca.","Samlah from Masrekah reigned in his place."]]},{"v":48,"pairs":[["Sed","Then Samlah also died,"],["et Semla mortuus est,","and Shaul from Rehoboth,"],["et regnavit pro eo Saul de Rohoboth,","which is situated beside a river,"],["quæ juxta amnem sita est.","reigned in his place."]]},{"v":49,"pairs":[["Mortuo quoque Saul,","Shaul also having died,"],["regnavit pro eo Balanan filius Achobor.","Baal-hanan, the son of Achbor, reigned in his place."]]},{"v":50,"pairs":[["Sed et hic mortuus est, et regnavit pro eo Adad:","Then he too died, and Hadar reigned in his place."],["cujus urbis nomen fuit Phau,","And the name of his city was Pau."],["et appellata est uxor ejus Meetabel filia Matred filiæ Mezaab.","And his wife was called Mehetabel, the daughter of Matred, the daughter of Mezahab."]]},{"v":51,"pairs":[["Adad autem mortuo,","And Hadar having died,"],["duces pro regibus in Edom esse cœperunt:","there began to be commanders in Edom in place of kings:"],["dux Thamna,","commander Thamna,"],["dux Alva,","commander Alvah,"],["dux Jetheth,","commander Jetheth,"]]},{"v":52,"pairs":[["dux Oolibama,","commander Oholibamah,"],["dux Ela,","commander Elah,"],["dux Phinon,","commander Pinon,"]]},{"v":53,"pairs":[["dux Cenez,","commander Kanez,"],["dux Theman,","commander Teman,"],["dux Mabsar,","commander Mibzar,"]]},{"v":54,"pairs":[["dux Magdiel,","commander Magdiel,"],["dux Hiram:","commander Iram."],["hi duces Edom.","These are the commanders of Edom."]]}]}