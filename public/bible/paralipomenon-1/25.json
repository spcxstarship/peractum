{"book":"paralipomenon-1","chapter":25,"verses":[{"v":1,"pairs":[["Igitur David","Then David and the magistrates of the army set apart,"],["et magistratus exercitus segregaverunt in ministerium filios Asaph,","for the ministry,"],["et Heman,","the sons of Asaph,"],["et Idithun,","and of Heman,"],["qui prophetarent in citharis,","and of Jeduthun,"],["et psalteriis,","who were to prophesy with harps and psalteries and cymbals,"],["et cymbalis secundum numerum suum,","in accord with their number,"],["dedicato sibi officio servientes.","having been dedicated to their appointed office."]]},{"v":2,"pairs":[["De filiis Asaph:","From the sons of Asaph:"],["Zachur,","Zaccur,"],["et Joseph,","and Joseph,"],["et Nathania,","and Nethaniah,"],["et Asarela,","and Asharelah,"],["filii Asaph:","the sons of Asaph,"],["sub manu Asaph prophetantis juxta regem.","under the hand of Asaph, prophesying beside the king."]]},{"v":3,"pairs":[["Porro Idithun:","Then of Jeduthun,"],["filii Idithun,","the sons of Jeduthun:"],["Godolias,","Gedaliah,"],["Sori,","Zeri,"],["Jeseias,","Jeshaiah,"],["et Hasabias,","and Hashabiah,"],["et Mathathias,","and Mattithiah,"],["sex,","six,"],["sub manu patris sui Idithun,","under the hand of their father Jeduthun,"],["qui in cithara prophetabat super confitentes","who was prophesying with stringed instruments,"],["et laudantes Dominum.","while confessing and praising the Lord."]]},{"v":4,"pairs":[["Heman quoque:","Also, of Heman,"],["filii Heman,","the sons of Heman:"],["Bocciau,","Bukkiah,"],["Mathaniau,","Mattaniah,"],["Oziel,","Uzziel,"],["Subuel,","Shebuel,"],["et Jerimoth,","and Jerimoth,"],["Hananias,","Hananiah,"],["Hanani,","Hanani,"],["Eliatha,","Eliathah,"],["Geddelthi,","Giddalti,"],["et Romemthiezer,","and Romamtiezer,"],["et Jesbacassa,","and Joshbekashah,"],["Mellothi,","Mallothi,"],["Othir,","Hothir,"],["Mahazioth:","Mahazioth."]]},{"v":5,"pairs":[["omnes isti filii Heman videntis regis in sermonibus Dei,","All these were the sons of Heman,"],["ut exaltaret cornu:","the seer of the king in the words of God,"],["deditque Deus Heman filios quatuordecim,","in order to lift up the horn."],["et filias tres.","And God gave to Heman fourteen sons and three daughters."]]},{"v":6,"pairs":[["Universi sub manu patris sui ad cantandum in templo Domini distributi erant,","All these, under their father’s hand, were distributed in order to sing in the temple of the Lord,"],["in cymbalis, et psalteriis,","with cymbals and psalteries and harps,"],["et citharis, in ministeria domus Domini juxta regem:","in the ministry of the house of the Lord beside the king,"],["Asaph videlicet,","specifically, Asaph,"],["et Idithun,","and Jeduthun,"],["et Heman.","and Heman."]]},{"v":7,"pairs":[["Fuit autem numerus eorum cum fratribus suis,","Now the number of these, with their brothers,"],["qui erudiebant canticum Domini,","who were instructing in the song of the Lord,"],["cuncti doctores,","all the teachers,"],["ducenti octoginta octo.","were two hundred eighty-eight."]]},{"v":8,"pairs":[["Miseruntque sortes per vices suas,","And they cast lots in their turns,"],["ex æquo tam major quam minor,","the elder equally with the younger,"],["doctus pariter et indoctus.","the learned together with the unlearned."]]},{"v":9,"pairs":[["Egressaque est sors prima Joseph,","And the first lot went forth to Joseph,"],["qui erat de Asaph.","who was of Asaph;"],["Secunda Godoliæ,","the second went forth to Gedaliah,"],["ipsi et filiis ejus,","to him and his sons and his brothers,"],["et fratribus ejus duodecim.","twelve."]]},{"v":10,"pairs":[["Tertia Zachur,","The third went to Zaccur,"],["filiis","to his sons and brothers,"],["et fratribus ejus duodecim.","twelve."]]},{"v":11,"pairs":[["Quarta Isari,","The fourth went to Izri,"],["filiis","to his sons and brothers,"],["et fratribus ejus duodecim.","twelve."]]},{"v":12,"pairs":[["Quinta Nathaniæ,","The fifth went to Nethaniah,"],["filiis","to his sons and brothers,"],["et fratribus ejus duodecim.","twelve."]]},{"v":13,"pairs":[["Sexta Bocciau,","The sixth went to Bukkiah,"],["filiis","to his sons and brothers,"],["et fratribus ejus duodecim.","twelve."]]},{"v":14,"pairs":[["Septima Isreela,","The seventh went to Jesharelah,"],["filiis","to his sons and brothers,"],["et fratribus ejus duodecim.","twelve."]]},{"v":15,"pairs":[["Octava Jesaiæ,","The eighth went to Jeshaiah,"],["filiis","to his sons and brothers,"],["et fratribus ejus duodecim.","twelve."]]},{"v":16,"pairs":[["Nona Mathaniæ,","The ninth went to Mattaniah,"],["filiis","to his sons and brothers,"],["et fratribus ejus duodecim.","twelve."]]},{"v":17,"pairs":[["Decima Semeiæ,","The tenth went to Shimei,"],["filiis","to his sons and brothers,"],["et fratribus ejus duodecim.","twelve."]]},{"v":18,"pairs":[["Undecima Azareel,","The eleventh went to Azarel,"],["filiis","to his sons and brothers,"],["et fratribus ejus duodecim.","twelve."]]},{"v":19,"pairs":[["Duodecima Hasabiæ,","The twelfth went to Hashabiah,"],["filiis","to his sons and brothers,"],["et fratribus ejus duodecim.","twelve."]]},{"v":20,"pairs":[["Tertiadecima Subaël,","The thirteenth went to Shubael,"],["filiis","to his sons and brothers,"],["et fratribus ejus duodecim.","twelve."]]},{"v":21,"pairs":[["Quartadecima Mathathiæ,","The fourteenth went to Mattithiah,"],["filiis","to his sons and brothers,"],["et fratribus ejus duodecim.","twelve."]]},{"v":22,"pairs":[["Quintadecima Jerimoth,","The fifteenth went to Jeremoth,"],["filiis","to his sons and brothers,"],["et fratribus ejus duodecim.","twelve."]]},{"v":23,"pairs":[["Sextadecima Hananiæ,","The sixteenth went to Hananiah,"],["filiis","to his sons and brothers,"],["et fratribus ejus duodecim.","twelve."]]},{"v":24,"pairs":[["Septimadecima Jesbacassæ,","The seventeenth went to Joshbekashah,"],["filiis","to his sons and brothers,"],["et fratribus ejus duodecim.","twelve."]]},{"v":25,"pairs":[["Octavadecima Hanani,","The eighteenth went to Hanani,"],["filiis","to his sons and brothers,"],["et fratribus ejus duodecim.","twelve."]]},{"v":26,"pairs":[["Nonadecima Mellothi,","The nineteenth went to Mallothi,"],["filiis","to his sons and his brothers,"],["et fratribus ejus duodecim.","twelve."]]},{"v":27,"pairs":[["Vigesima Eliatha,","The twentieth went to Eliathah,"],["filiis","to his sons and brothers,"],["et fratribus ejus duodecim.","twelve."]]},{"v":28,"pairs":[["Vigesima prima Othir,","The twenty-first went to Hothir,"],["filiis","to his sons and brothers,"],["et fratribus ejus duodecim.","twelve."]]},{"v":29,"pairs":[["Vigesima secunda Geddelthi,","The twenty-second went to Giddalti,"],["filiis","to his sons and brothers,"],["et fratribus ejus duodecim.","twelve."]]},{"v":30,"pairs":[["Vigesima tertia Mahazioth,","The twenty-third went to Mahazioth,"],["filiis","to his sons and brothers,"],["et fratribus ejus duodecim.","twelve."]]},{"v":31,"pairs":[["Vigesima quarta Romemthiezer,","The twenty-fourth went to Romamtiezer,"],["filiis","to his sons and brothers,"],["et fratribus ejus duodecim.","twelve."]]}]}