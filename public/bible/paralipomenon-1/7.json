{"book":"paralipomenon-1","chapter":7,"verses":[{"v":1,"pairs":[["Porro filii Issachar: Thola, et Phua,","Now the sons of Issachar were Tola and Puah,"],["Jasub, et Simeron,","Jashub and Shimron,"],["quatuor.","four."]]},{"v":2,"pairs":[["Filii Thola:","The sons of Tola:"],["Ozi,","Uzzi,"],["et Raphaia,","and Rephaiah,"],["et Jeriel,","and Jeriel,"],["et Jemai,","and Jahmai,"],["et Jebsem,","and Ibsam,"],["et Samuel,","and Shemuel,"],["principes per domos cognationum suarum.","leaders according to the houses of their kindred."],["De stirpe Thola viri fortissimi numerati sunt in diebus David,","From the stock of Tola, there were numbered, in the days of David,"],["viginti duo millia sexcenti.","twenty-two thousand six hundred very strong men."]]},{"v":3,"pairs":[["Filii Ozi:","The sons of Uzzi:"],["Izrahia,","Izrahiah,"],["de quo nati sunt Michaël,","from whom were born: Michael,"],["et Obadia,","and Obadiah,"],["et Joël,","and Joel,"],["et Jesia,","and Isshiah;"],["quinque omnes principes.","all five were leaders."]]},{"v":4,"pairs":[["Cumque eis per familias et populos suos,","And with them, by their families and peoples,"],["accincti ad prælium, viri fortissimi,","there were thirty-six thousand very strong men,"],["triginta sex millia:","girded for battle."],["multas enim habuerunt uxores, et filios.","And they had many wives and children."]]},{"v":5,"pairs":[["Fratres quoque eorum per omnem cognationem Issachar robustissimi ad pugnandum, octoginta septem millia numerati sunt.","Also, their brothers, throughout all the kindred of Issachar, were numbered as eighty-seven thousand, very fit for battle."]]},{"v":6,"pairs":[["Filii Benjamin:","The sons of Benjamin:"],["Bela,","Bela,"],["et Bechor,","and Becher,"],["et Jadihel,","and Jediael,"],["tres.","three."]]},{"v":7,"pairs":[["Filii Bela: Esbon,","The sons of Bela:"],["et Ozi,","Ezbon,"],["et Oziel,","and Uzzi,"],["et Jerimoth,","and Uzziel,"],["et Urai, quinque principes familiarum,","and Jerimoth and Iri, five leaders of families,"],["et ad pugnandum robustissimi:","also very fit for battle;"],["numerus autem eorum, viginti duo millia et triginta quatuor.","and their number was twenty-two thousand thirty-four."]]},{"v":8,"pairs":[["Porro filii Bechor:","Now the sons of Becher:"],["Zamira,","Zemirah,"],["et Joas,","and Joash,"],["et Eliezer,","and Eliezer,"],["et Elioënai,","and Elioenai,"],["et Amri,","and Omri,"],["et Jerimoth,","and Jeremoth,"],["et Abia,","and Abijah,"],["et Anathoth,","and Anathoth,"],["et Almath:","and Alemeth:"],["omnes hi filii Bechor.","all these were sons of Becher."]]},{"v":9,"pairs":[["Numerati sunt autem per familias suas principes cognationum suarum ad bella fortissimi,","And they were numbered according to their families, by the leaders of their kindred, very strong in warfare,"],["viginti millia et ducenti.","twenty thousand and two hundred."]]},{"v":10,"pairs":[["Porro filii Jadihel:","And the sons of Jediael:"],["Balan.","Bilhan,"],["Filii autem Balan:","and the sons of Bilhan:"],["Jehus,","Jeush,"],["et Benjamin,","and Benjamin,"],["et Aod,","and Ehud,"],["et Chanana,","and Chenaanah,"],["et Zethan,","and Zethan,"],["et Tharsis,","and Tarshish,"],["et Ahisahar:","and Ahishahar."]]},{"v":11,"pairs":[["omnes hi filii Jadihel,","All these were sons of Jediael,"],["principes cognationum suarum viri fortissimi,","the leaders of their kindred,"],["decem","very strong men,"],["et septem millia","seventeen thousand and two hundred,"],["et ducenti ad prælium procedentes.","going forth to battle."]]},{"v":12,"pairs":[["Sepham quoque et Hapham filii Hir:","Also, Shuppim and Huppim, the sons of Ir;"],["et Hasim filii Aher.","and Hushim, sons of Aher."]]},{"v":13,"pairs":[["Filii autem Nephthali:","Then the sons of Naphtali:"],["Jaziel,","Jahziel,"],["et Guni,","and Guni,"],["et Jeser,","and Jezer,"],["et Sellum,","and Shallum,"],["filii Bala.","sons of Bilhah."]]},{"v":14,"pairs":[["Porro filius Manasse, Esriel: concubinaque ejus Syra peperit Machir patrem Galaad.","Also, the son of Manasseh: Asriel. And his concubine, a Syrian, bore Machir, the father of Gilead."]]},{"v":15,"pairs":[["Machir autem accepit uxores filiis suis Happhim,","Now Machir took wives for his sons,"],["et Saphan:","Huppim"],["et habuit sororem nomine Maacha:","and Shuppim."],["nomen autem secundi,","And he had a sister named Maacah;"],["Salphaad,","but the name of the second was Zelophehad,"],["natæque sunt Salphaad filiæ.","and daughters were born to Zelophehad."]]},{"v":16,"pairs":[["Et peperit Maacha uxor Machir filium,","And Maacah,"],["vocavitque nomen ejus Phares:","the wife of Machir,"],["porro nomen fratris ejus,","bore a son,"],["Sares:","and she called his name Peresh."],["et filii ejus,","And the name of his brother was Sheresh."],["Ulam,","And his sons were Ulam"],["et Recen.","and Rakem."]]},{"v":17,"pairs":[["Filius autem Ulam,","Then the son of Ulam:"],["Badan:","Bedan."],["hi sunt filii Galaad,","These are the sons of Gilead,"],["filii Machir,","the son of Machir,"],["filii Manasse.","the son of Manasseh."]]},{"v":18,"pairs":[["Soror autem ejus Regina peperit Virum decorum,","And his sister, Regina, bore Ishhod,"],["et Abiezer,","and Abiezer,"],["et Mohola.","and Mahlah."]]},{"v":19,"pairs":[["Erant autem filii Semida, Ahin,","Now the sons of Shemida were Ahian,"],["et Sechem,","and Shechem,"],["et Leci, et Aniam.","and Likhi and Aniam."]]},{"v":20,"pairs":[["Filii autem Ephraim:","And the sons of Ephraim:"],["Suthala,","Shuthelah,"],["Bared filius ejus,","Bered his son,"],["Thahath filius ejus,","Tahath his son,"],["Elada filius ejus,","Eleadah his son,"],["Thahath filius ejus,","Tahath his son,"],["hujus filius Zabad,","whose son was Zabad,"]]},{"v":21,"pairs":[["et hujus filius Suthula,","and his son was Shuthelah,"],["et hujus filius Ezer","and his son was Ezer,"],["et Elad:","and also Elead."],["occiderunt autem eos viri Geth indigenæ,","But the men indigenous to Gath killed them,"],["quia descenderant ut invaderent possessiones eorum.","because they had descended to invade their possessions."]]},{"v":22,"pairs":[["Luxit igitur Ephraim pater eorum multis diebus,","And so their father, Ephraim, mourned for many days;"],["et venerunt fratres ejus ut consolarentur eum.","and his brothers arrived, so that they might console him."]]},{"v":23,"pairs":[["Ingressusque est ad uxorem suam:","And he entered to his wife;"],["quæ concepit,","she conceived"],["et peperit filium,","and bore a son."],["et vocavit nomen ejus Beria,","And he called his name Beriah,"],["eo quod in malis domus ejus ortus esset:","because he rose up during a time of evil for his house."]]},{"v":24,"pairs":[["filia autem ejus fuit Sara,","Now his daughter was Sheerah,"],["quæ ædificavit Bethoron inferiorem et superiorem,","who built lower and upper Beth-horon,"],["et Ozensara.","and also Uzzen-sheerah."]]},{"v":25,"pairs":[["Porro filius ejus Rapha,","And Rephah was his son,"],["et Reseph,","and Resheph,"],["et Thale,","and Telah,"],["de quo natus est Thaan,","from whom was born Tahan,"]]},{"v":26,"pairs":[["qui genuit Laadan:","who conceived Ladan."],["hujus quoque filius Ammiud,","And his son was Ammihud,"],["qui genuit Elisama,","who conceived Elishama,"]]},{"v":27,"pairs":[["de quo ortus est Nun,","from whom was born Nun,"],["qui habuit filium Josue.","who had Joshua as a son."]]},{"v":28,"pairs":[["Possessio autem eorum","Now their possessions and habitations were:"],["et habitatio,","Bethel with her daughters,"],["Bethel cum filiabus suis,","and toward the east,"],["et contra orientem Noran,","Naaran,"],["ad occidentalem plagam Gazer","and toward the western region,"],["et filiæ ejus,","Gezer and her daughters,"],["Sichem quoque cum filiabus suis,","as well as Shechem with her daughters,"],["usque ad Aza cum filiabus ejus.","as far as Ayyah with her daughters;"]]},{"v":29,"pairs":[["Juxta filios quoque Manasse,","also, beside the sons of Manasseh,"],["Bethsan et filias ejus,","Bethshean and her daughters,"],["Thanach et filias ejus,","Taanach and her daughters,"],["Mageddo et filias ejus,","Megiddo and her daughters,"],["Dor et filias ejus:","Dor and her daughters."],["in his habitaverunt filii Joseph,","In these places, there lived the sons of Joseph,"],["filii Israël.","the son of Israel."]]},{"v":30,"pairs":[["Filii Aser:","The sons of Asher:"],["Jemna,","Imnah,"],["et Jesua,","and Ishvah,"],["et Jessui,","and Ishvi,"],["et Baria,","and Beriah,"],["et Sara soror eorum.","and Serah their sister."]]},{"v":31,"pairs":[["Filii autem Baria:","And the sons of Beriah:"],["Heber,","Heber,"],["et Melchiel:","and Malchiel,"],["ipse est pater Barsaith.","the same is the father of Birzaith."]]},{"v":32,"pairs":[["Heber autem genuit Jephlat,","Now Heber conceived Japhlet,"],["et Somer,","and Shomer,"],["et Hotham,","and Hotham,"],["et Suaa sororem eorum.","and their sister Shua."]]},{"v":33,"pairs":[["Filii Jephlat:","The sons of Japhlet:"],["Phosech,","Pasach,"],["et Chamaal,","and Bimhal,"],["et Asoth:","and Ashvath;"],["hi filii Jephlat.","these are the sons of Japhlet."]]},{"v":34,"pairs":[["Porro filii Somer:","Then the sons of Shomer:"],["Ahi,","Ahi,"],["et Roaga,","and Rohgah,"],["et Haba,","and Jehubbah,"],["et Aram.","and Aram."]]},{"v":35,"pairs":[["Filii autem Helem fratris ejus:","And the sons of Helem, his brother:"],["Supha,","Zophah,"],["et Jemna,","and Imna,"],["et Selles,","and Shelesh,"],["et Amal.","and Amal."]]},{"v":36,"pairs":[["Filii Supha:","The sons of Zophah:"],["Sue,","Suah,"],["Harnapher,","Harnepher,"],["et Sual,","and Shual,"],["et Beri,","and Beri,"],["et Jamra,","and Imrah,"]]},{"v":37,"pairs":[["Bosor,","Bezer,"],["et Hod,","and Hod,"],["et Samma,","and Shamma,"],["et Salusa,","and Shilshah,"],["et Jethran,","and Ithran,"],["et Bera.","and Beera."]]},{"v":38,"pairs":[["Filii Jether:","The sons of Jether:"],["Jephone,","Jephunneh,"],["et Phaspha,","and Pispa,"],["et Ara.","and Ara."]]},{"v":39,"pairs":[["Filii autem Olla:","Then the sons of Ulla:"],["Aree,","Arah,"],["et Haniel,","and Hanniel,"],["et Resia.","and Rizia."]]},{"v":40,"pairs":[["Omnes hi filii Aser,","All these were sons of Asher,"],["principes cognationum,","the leaders of families,"],["electi atque fortissimi duces ducum:","elect"],["numerus autem eorum ætatis quæ apta esset ad bellum,","and very strong rulers among rulers."],["viginti sex millia.","And the number of those who were of an age that was fit for warfare was twenty-six thousand."]]}]}