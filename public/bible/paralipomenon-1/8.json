{"book":"paralipomenon-1","chapter":8,"verses":[{"v":1,"pairs":[["Benjamin autem genuit Bale primogenitum suum,","Now Benjamin conceived Bela as his firstborn,"],["Asbel secundum,","Ashbel the second,"],["Ahara tertium,","Aharah the third,"]]},{"v":2,"pairs":[["Nohaa quartum,","Nohah the fourth,"],["et Rapha quintum.","and Rapha the fifth."]]},{"v":3,"pairs":[["Fueruntque filii Bale:","And the sons of Bela were:"],["Addar,","Addar,"],["et Gera,","and Gera,"],["et Abiud,","and Abihud,"]]},{"v":4,"pairs":[["Abisue quoque","as well as Abishua,"],["et Naaman,","and Naaman,"],["et Ahoë,","and Ahoah,"]]},{"v":5,"pairs":[["sed et Gera,","then also Gera,"],["et Sephuphan,","and Shephuphan,"],["et Huram.","and Huram."]]},{"v":6,"pairs":[["Hi sunt filii Ahod,","These are the sons of Ehud,"],["principes cognationum habitantium in Gabaa,","leaders of the kindred living in Geba,"],["qui translati sunt in Manahath.","who were moved away to Manahath."]]},{"v":7,"pairs":[["Naaman autem,","And Naaman,"],["et Achia,","and Ahijah,"],["et Gera,","and Gera,"],["ipse transtulit eos,","he also moved them away;"],["et genuit Osa,","and he conceived Uzza"],["et Ahiud.","and Ahihud."]]},{"v":8,"pairs":[["Porro Saharaim genuit in regione Moab,","Then Shaharaim conceived, in the region of Moab,"],["postquam dimisit Husim et Bara uxores suas.","after he sent away Hushim and Baara, his wives;"]]},{"v":9,"pairs":[["Genuit autem de Hodes uxore sua Jobab,","and so, of his wife Hodesh, he conceived Jobab,"],["et Sebia,","and Zibia,"],["et Mosa,","and Mesha,"],["et Molchom,","and Malcam,"]]},{"v":10,"pairs":[["Jehus quoque,","and also Jeuz and Sachia,"],["et Sechia,","and Mirmah."],["et Marma:","These were his sons,"],["hi sunt filii ejus principes in familiis suis.","the leaders of their families."]]},{"v":11,"pairs":[["Mehusim vero genuit Abitob","Truly,"],["et Elphaal.","of Hushim he conceived Abitub and Elpaal."]]},{"v":12,"pairs":[["Porro filii Elphaal: Heber,","And the sons of Elpaal were Eber,"],["et Misaam,","and Misham,"],["et Samad:","and Shemed,"],["hic ædificavit Ono, et Lod, et filias ejus.","who built Ono and Lod and its daughters."]]},{"v":13,"pairs":[["Baria autem et Sama principes cognationum habitantium in Ajalon:","Now Beriah and Shema were leaders of their families living in Aijalon;"],["hi fugaverunt habitatores Geth.","these put to flight the inhabitants of Gath."]]},{"v":14,"pairs":[["Et Ahio,","And Ahio,"],["et Sesac,","and Shashak,"],["et Jerimoth,","and Jeremoth,"]]},{"v":15,"pairs":[["et Zabadia,","and Zebadiah,"],["et Arod,","and Arad,"],["et Heder,","and Eder,"]]},{"v":16,"pairs":[["Michaël quoque,","as well as Michael,"],["et Jespha,","and Ishpah,"],["et Joha filii Baria.","and Joha, were the sons of Beriah."]]},{"v":17,"pairs":[["Et Zabadia,","Then Zebadiah,"],["et Mosollam,","and Meshullam,"],["et Hezeci,","and Hizki,"],["et Heber,","and Heber,"]]},{"v":18,"pairs":[["et Jesamari,","and Ishmerai,"],["et Jezlia,","and Izliah,"],["et Jobab filii Elphaal,","and Jobab were the sons of Elpaal."]]},{"v":19,"pairs":[["et Jacim,","Then Jakim,"],["et Zechri,","and Zichri,"],["et Zabdi,","and Zabdi,"]]},{"v":20,"pairs":[["et Elioënai,","and Elienai,"],["et Selethai,","and Zillethai,"],["et Eliel,","and Eliel,"]]},{"v":21,"pairs":[["et Adaia,","and Adaiah,"],["et Baraia,","and Beraiah,"],["et Samarath, filii Semei.","and Shimrath were the sons of Shimei."]]},{"v":22,"pairs":[["Et Jespham,","Then Ishpan,"],["et Heber,","and Eber,"],["et Eliel,","and Eliel,"]]},{"v":23,"pairs":[["et Abdon,","and Abdon,"],["et Zechri,","and Zichri,"],["et Hanan,","and Hanan,"]]},{"v":24,"pairs":[["et Hanania,","and Hananiah,"],["et Ælam,","and Elam,"],["et Anathothia,","and Anthothijah,"]]},{"v":25,"pairs":[["et Jephdaia,","and Iphdeiah,"],["et Phanuel, filii Sesac.","and Penuel were the sons of Shashak."]]},{"v":26,"pairs":[["Et Samsari,","Then Shamsherai,"],["et Sohoria,","and Shehariah"],["et Otholia,","and Athaliah,"]]},{"v":27,"pairs":[["et Jersia,","and Jaareshiah,"],["et Elia,","and Elijah,"],["et Zechri, filii Jeroham.","and Zichri were the sons of Jeroham."]]},{"v":28,"pairs":[["Hi patriarchæ, et cognationum principes, qui habitaverunt in Jerusalem.","These were the patriarchs and leaders of the families who were living in Jerusalem."]]},{"v":29,"pairs":[["In Gabaon autem habitaverunt Abigabaon,","Now in Gibeon, there lived Jeiel, the father of Gibeon;"],["et nomen uxoris ejus Maacha:","and the name of his wife was Maacah,"]]},{"v":30,"pairs":[["filiusque ejus primogenitus Abdon,","and his firstborn son was Abdon,"],["et Sur,","and then Zur,"],["et Cis,","and Kish,"],["et Baal,","and Baal,"],["et Nadab,","and Nadab,"]]},{"v":31,"pairs":[["Gedor quoque,","and Gedor,"],["et Ahio,","and Ahio,"],["et Zacher,","and Zecher,"],["et Macelloth:","and Mikloth."]]},{"v":32,"pairs":[["et Macelloth genuit Samaa:","And Mikloth conceived Shimeah."],["habitaveruntque ex adverso fratrum suorum in Jerusalem cum fratribus suis.","And they lived opposite their brothers in Jerusalem, with their brothers."]]},{"v":33,"pairs":[["Ner autem genuit Cis,","Now Ner conceived Kish,"],["et Cis genuit Saul.","and Kish conceived Saul."],["Porro Saul genuit Jonathan,","Then Saul conceived Jonathan,"],["et Melchisua,","and Malchishua,"],["et Abinadab,","and Abinadab,"],["et Esbaal.","and Eshbaal."]]},{"v":34,"pairs":[["Filius autem Jonathan, Meribbaal:","And the son of Jonathan was Meribbaal;"],["et Meribbaal genuit Micha.","and Meribbaal conceived Micah."]]},{"v":35,"pairs":[["Filii Micha, Phithon,","The sons of Micah were Pithon,"],["et Melech,","and Melech,"],["et Tharaa,","and Tarea,"],["et Ahaz.","and Ahaz."]]},{"v":36,"pairs":[["Et Ahaz genuit Joada,","And Ahaz conceived Jehoaddah."],["et Joada genuit Alamath,","And Jehoaddah conceived Alemeth,"],["et Azmoth,","and Azmaveth,"],["et Zamri:","and Zimri."],["porro Zamri genuit Mosa,","And Zimri conceived Moza."]]},{"v":37,"pairs":[["et Mosa genuit Banaa,","And Moza conceived Binea,"],["cujus filius fuit Rapha,","whose son was Raphah,"],["de quo ortus est Elasa,","of whom was born Eleasah,"],["qui genuit Asel.","who conceived Azel."]]},{"v":38,"pairs":[["Porro Asel sex filii fuerunt his nominibus:","Now there were six sons for Azel,"],["Ezricam,","whose names were Azrikam,"],["Bocru,","Bocheru,"],["Ismahel,","Ishmael,"],["Saria,","Sheariah,"],["Obdia,","Obadiah,"],["et Hanan:","and Hanan."],["omnes hi filii Asel.","All these were the sons of Azel."]]},{"v":39,"pairs":[["Filii autem Esec fratris ejus,","Then the sons of Eshek, his brother,"],["Ulam primogenitus,","were Ulam the firstborn,"],["et Jehus secundus,","and Jeush the second,"],["et Eliphalet tertius.","and Eliphelet the third."]]},{"v":40,"pairs":[["Fueruntque filii Ulam viri robustissimi,","And the sons of Ulam were very robust men,"],["et magno robore tendentes arcum:","drawing the bow with great strength."],["et multos habentes filios ac nepotes,","And they had many sons and grandsons,"],["usque ad centum quinquaginta.","even to one hundred fifty."],["Omnes hi filii Benjamin.","All these were sons of Benjamin."]]}]}