# Part of speech, shown as the card's corner chip ("NOUN", "VERB", ...).
def pos_of(cls):
    if "adjective" in cls:
        return "adjective"
    if "pronoun" in cls:
        return "pronoun"
    # function words BEFORE the verb check: "verb" is a substring of "adverb"
    for w in ("preposition", "conjunction", "adverb", "interjection", "numeral"):
        if w in cls:
            return w
    if "noun" in cls or "declension" in cls:
        return "noun"
    if "verb" in cls or "conjugation" in cls:
        return "verb"
    return ""

# Declensions and conjugations as Roman numerals (Olivetti dictionary
# convention Michael liked): "feminine · I declension", "III conjugation".
def romanize(cls):
    for a, b in [
        ("first- and second-declension", "I-II declension"),
        ("third-declension", "III declension"),
        ("first declension", "I declension"),
        ("second declension", "II declension"),
        ("third declension", "III declension"),
        ("fourth declension", "IV declension"),
        ("fifth declension", "V declension"),
        ("first conjugation", "I conjugation"),
        ("second conjugation", "II conjugation"),
        ("third conjugation", "III conjugation"),
    ]:
        cls = cls.replace(a, b)
    return cls


# The grammar line reads "pos · class facts · occurrence" for every word,
# so class strings must not repeat the part of speech: "III declension
# adjective" becomes attrs "III declension" under kind "adjective".
def attrs_of(cls):
    a = cls
    for pat, rep in [
        ("III declension adjective", "III declension"),
        ("I-II declension adjective", "I-II declension"),
        ("ordinal adjective", "ordinal"),
        ("possessive adjective", "possessive"),
        ("comparative adjective", "comparative"),
        ("numeral adjective", "numeral"),
        ("irregular verb", "irregular"),
        ("defective verb", "defective"),
        ("indeclinable noun", "indeclinable"),
        ("relative pronoun", "relative"),
        ("personal pronoun", "personal"),
        ("reflexive pronoun", "reflexive"),
    ]:
        a = a.replace(pat, rep)
    return a.replace(", ", " · ")


# Parse-line rule: only occurrence facts, in conventional case-number-gender
# order. Nouns never state gender (it is a lemma fact, shown below the line);
# adjectives and pronouns do, because theirs is borrowed by agreement.
PARSE_FIX = {
 "inanis": "nominative singular feminine",
 "vacua": "nominative singular feminine",
 "bona": "nominative singular feminine",
 "eam": "accusative singular feminine",
