      (13, 14, "c"), (0, 17, "o"), (8, 9, "d"), (14, 15, "d"),
      (5, 6, "a"), (11, 12, "a")],
 17: [(1, 2, "o"), (3, 4, "w"), (4, 5, "g"), (6, 7, "c"), (8, 9, "w")],
 18: [(6, 7, "o"), (6, 9, "o"), (11, 12, "s"), (13, 14, "c"), (1, 2, "d"), (1, 4, "d")],
 19: [(5, 6, "a")],
 20: [(0, 2, "s"), (3, 4, "s"), (3, 5, "o"), (5, 6, "g"), (6, 7, "a"),
      (3, 9, "o"), (10, 11, "w"), (12, 13, "w"), (13, 14, "g")],
 21: [(0, 1, "s"), (0, 2, "o"), (2, 3, "a"), (0, 6, "o"), (6, 5, "a"),
      (6, 7, "a"), (6, 9, "a"), (11, 10, "o"), (11, 12, "s"),
      (13, 14, "w"), (14, 15, "a"), (0, 18, "o"), (18, 17, "a"),
      (19, 20, "w"), (20, 21, "a"), (23, 24, "s"), (25, 26, "c")],
 22: [(7, 8, "o"), (8, 9, "g"), (11, 10, "s"), (12, 13, "w"), (0, 1, "d")],
 23: [(5, 6, "a")],
 24: [(0, 2, "s"), (3, 4, "s"), (3, 5, "o"), (5, 6, "a"), (7, 8, "w"),
      (8, 9, "a"), (3, 10, "o"), (3, 12, "o"), (3, 14, "o"),
      (14, 15, "g"), (16, 17, "w"), (17, 18, "a")],
 25: [(1, 2, "s"), (1, 3, "o"), (3, 4, "g"), (5, 6, "w"), (6, 7, "a"),
      (1, 9, "o"), (1, 12, "o"), (12, 11, "a"), (12, 13, "g"),
      (14, 15, "w"), (15, 16, "a"), (18, 19, "s"), (20, 21, "c")],
 26: [(2, 3, "o"), (4, 5, "w"), (4, 7, "w"), (7, 8, "a"), (11, 12, "g"), (14, 15, "g"),
      (23, 22, "s"), (24, 25, "w"), (10, 11, "d"), (10, 14, "d"), (10, 17, "d"),
      (10, 19, "d"), (10, 21, "d"), (19, 18, "a"), (21, 20, "a")],
 27: [(1, 2, "s"), (1, 3, "o"), (4, 5, "w"), (5, 6, "a"), (7, 8, "w"),
      (8, 9, "g"), (10, 11, "o"), (15, 12, "o"), (15, 14, "o"), (15, 16, "o")],
 28: [(0, 2, "s"), (9, 10, "o"), (12, 13, "o"), (16, 17, "g"), (19, 20, "g"),
      (25, 24, "s"), (26, 27, "w"), (0, 1, "d"), (15, 16, "d"), (15, 19, "d"),
      (15, 23, "d"), (23, 22, "a")],
 29: [(0, 1, "s"), (3, 4, "d"), (3, 6, "o"), (3, 13, "o"), (6, 5, "a"),
      (6, 7, "a"), (7, 8, "o"), (9, 10, "w"), (13, 12, "a"), (15, 14, "s"),
      (15, 18, "o"), (16, 17, "w"), (18, 19, "g"), (19, 20, "a"),
      (21, 22, "c"), (22, 23, "d"), (24, 25, "w")],
 30: [(2, 1, "a"), (2, 3, "g"), (5, 4, "a"), (5, 6, "g"), (10, 9, "s"),
      (11, 12, "w"), (14, 15, "w"), (16, 17, "s"), (17, 18, "a"),
      (19, 20, "c"), (21, 22, "w")],
 31: [(0, 1, "s"), (0, 2, "o"), (4, 3, "o"), (6, 2, "s"), (2, 8, "a"), (14, 15, "a")],
}

CLAUSE_TYPES = {"s": "subject", "o": "object", "d": "recipient"}
GLOW_TYPES = {"s", "o", "d", "g", "a", "w", "c"}

# Pairwise phrasing (everything except clause groups, which render in the
# verse's own word order).
HEAD_PHRASE = {"a": "described by", "w": "with", "g": "belongs to", "c": "introduces"}
DEP_PHRASE = {"a": "adjective for", "w": "with", "g": "owner of", "c": "introduced by"}

d = json.load(open(f"{ROOT}/public/bible/genesis/1.json"))
verses = {}
forms = {}
missing = set()
missing_lemmas = set()

for v in d["verses"]:
    toks = " ".join(p[0] for p in v["pairs"]).split()
    out = []
    seen = collections.Counter()
    i = 0
    while i < len(toks):
        c1 = clean(toks[i])
        c2 = clean(toks[i + 1]) if i + 1 < len(toks) else None
        if c2 and (c1, c2) in MERGES:
            g, p, l, df = MERGES[(c1, c2)]
            display = toks[i] + " " + toks[i + 1]
            key = f"{c1} {c2}"
            n = bigrams[(c1, c2)]
            i += 2
        else:
            if c1 not in E:
                missing.add(c1)
                i += 1
                continue
            g, p, l, df = E[c1]
            display = toks[i]
            key = c1
            n = freq[c1]
            i += 1
        seen[key] += 1
        ov = OVERRIDES.get((v["v"], key, seen[key]), {})
        g = ov.get("g", g)
        p = ov.get("p", p)
        # forms map holds the default entry; per-token overrides ride on the token
        if key not in forms:
            default_parse = E[key][1] if key in E else p
            info = LEMMAS.get(l)
            if info is None:
                missing_lemmas.add(l)
                cite, cls = l, ""
            else:
                cite, cls = info[0] or l, info[1]
            forms[key] = {"p": default_parse, "l": cite,
                          "c": attrs_of(romanize(cls)),
                          "k": pos_of(cls), "d": df, "n": n}
        tok_entry = [display, g]
        if ov:
            tok_entry.append({k: ov[k] for k in ov})
        out.append(tok_entry)
    verses[str(v["v"])] = out

if missing:
    raise SystemExit(f"UNGLOSSED FORMS: {sorted(missing)}")
if missing_lemmas:
    raise SystemExit(f"LEMMAS WITHOUT CLASS INFO: {sorted(missing_lemmas)}")

# attach symmetric related-word links plus a card line naming each relation
def word_of(toks, i):
    return re.sub(r"[^\wÆæŒœëï ]+$", "", re.sub(r"^[^\wÆæŒœëï]+", "", toks[i][0].split(" ")[0] if " " not in toks[i][0] else toks[i][0]))

for vnum, pairs in RELATED.items():
    toks = verses[str(vnum)]
    clauses = {}   # verb index -> [(index, role), ...]
    pairwise = []  # agreement / with links
    for i, j, typ in pairs:
        assert i < len(toks) and j < len(toks), (vnum, i, j)
        if typ in CLAUSE_TYPES:
            clauses.setdefault(i, [(i, "verb")]).append((j, CLAUSE_TYPES[typ]))
        else:
            pairwise.append((i, j, typ))
    rel_r = {}     # index -> glow partner indices
    rel_line = {}  # index -> phrase list, clause line first
    # Whole clause in the verse's own word order; every member gets the same
    # line and glows every other member ("who did what", as the text put it).
    for members in clauses.values():
        ordered = sorted(members, key=lambda m: m[0])
        parts = []
        for idx, role in ordered:
            w = word_of(toks, idx)
            if parts and parts[-1][0] == role:
                parts[-1][1].append(w)
            else:
                parts.append((role, [w]))
        line = " · ".join(f"{role} {', '.join(ws)}" for role, ws in parts)
        idxs = [m[0] for m in members]
        for idx in idxs:
            rel_line.setdefault(idx, []).append(line)
            rel_r.setdefault(idx, set()).update(x for x in idxs if x != idx)
    rel_pairs = {}  # index -> [(phrase, word)] to be grouped by phrase
    for i, j, typ in pairwise:
        if typ in GLOW_TYPES:
            rel_r.setdefault(i, set()).add(j)
            rel_r.setdefault(j, set()).add(i)
        rel_pairs.setdefault(i, []).append((HEAD_PHRASE[typ], word_of(toks, j)))
        rel_pairs.setdefault(j, []).append((DEP_PHRASE[typ], word_of(toks, i)))
    for idx, parts in rel_pairs.items():
        grouped = []
        for phrase, w in parts:
            if grouped and grouped[-1][0] == phrase:
                grouped[-1][1].append(w)
            else:
                grouped.append((phrase, [w]))
        rel_line.setdefault(idx, []).extend(
            f"{ph} {', '.join(ws)}" for ph, ws in grouped
        )
    for idx, lines in rel_line.items():
        t = toks[idx]
        if len(t) == 2:
            t.append({})
        if rel_r.get(idx):
            t[2]["r"] = sorted(rel_r[idx])
        t[2]["rd"] = " · ".join(lines)

tables = build_tables(forms)

# First verb tables: sum, hand-coded (most frequent AND most irregular verb).
# Each block is one mood+tense, same grid shape as a noun table: persons
# down, singular/plural across. A tapped form opens its own block.
SUM_BLOCKS = {
 "sum-pres-ind": ("indicative · present",
   [("1st", "sum", "sumus"), ("2nd", "es", "estis"), ("3rd", "est", "sunt")]),
 "sum-impf-ind": ("indicative · imperfect",
   [("1st", "eram", "eramus"), ("2nd", "eras", "eratis"), ("3rd", "erat", "erant")]),
 "sum-fut-ind": ("indicative · future",
   [("1st", "ero", "erimus"), ("2nd", "eris", "eritis"), ("3rd", "erit", "erunt")]),
 "sum-perf-ind": ("indicative · perfect",
   [("1st", "fui", "fuimus"), ("2nd", "fuisti", "fuistis"), ("3rd", "fuit", "fuerunt")]),
 "sum-pres-subj": ("subjunctive · present",
   [("1st", "sim", "simus"), ("2nd", "sis", "sitis"), ("3rd", "sit", "sint")]),
 "sum-impf-subj": ("subjunctive · imperfect",
   [("1st", "essem", "essemus"), ("2nd", "esses", "essetis"), ("3rd", "esset", "essent")]),
}
for bk, (label, rows) in SUM_BLOCKS.items():
    tables[bk] = {
        "l": "sum, esse, fui",
        "c": label,
        "rows": [[p, [s, freq.get(s, 0)], [pl, freq.get(pl, 0)]]
                 for p, s, pl in rows],
    }
for k, e in forms.items():
    if e["l"] == "sum, esse, fui" and " " not in k:
        for bk, (label, rows) in SUM_BLOCKS.items():
            if any(k in (s, pl) for _, s, pl in rows):
                e["t"] = bk
                break
result = {"verses": verses, "forms": forms, "tables": tables}
path = f"{ROOT}/public/bible/genesis/1.gloss.json"
json.dump(result, open(path, "w"), ensure_ascii=False, separators=(",", ":"))
ntok = sum(len(t) for t in verses.values())
print(f"wrote {path}: {len(verses)} verses, {ntok} tokens, {len(forms)} forms, {len(tables)} tables")
# sanity: reconstructed Latin must equal the source text
for v in d["verses"]:
    src = " ".join(p[0] for p in v["pairs"])
    rec = " ".join(t[0] for t in verses[str(v["v"])])
    assert src == rec, f"verse {v['v']} mismatch:\n{src}\n{rec}"
print("reconstruction check passed")
