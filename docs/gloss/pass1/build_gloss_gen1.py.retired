 "tertius": "nominative singular masculine",
 "quartus": "nominative singular masculine",
 "quintus": "nominative singular masculine",
 "sextus": "nominative singular masculine",
}
for form, parse in PARSE_FIX.items():
    g, _, l, df = E[form]
    E[form] = (g, parse, l, df)
