 "universæque": "dative singular feminine, with -que (and) fused on",
 "omnem": "accusative singular feminine",
 "suum": "accusative singular neuter",
 "suo": "ablative singular neuter",
 "sui": "genitive singular neuter",
 "duo": "accusative plural neuter",
