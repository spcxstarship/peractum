# Builds public/bible/genesis/1.gloss.json for the reading-modes prototype.
# Every gloss is hand-authored against the CPDV rendering of the same verse;
# parses are spelled out in plain words. Frequencies are computed from the
# committed corpus so the popover numbers are real.
import json, re, glob, collections

ROOT = "/Users/michaelwork/Code/GitHub/peractum"

def clean(tok):
    return re.sub(r"[^\wÆæŒœëï]+$", "", re.sub(r"^[^\wÆæŒœëï]+", "", tok)).lower()

# ---------- corpus frequencies ----------
freq = collections.Counter()
bigrams = collections.Counter()
for f in glob.glob(f"{ROOT}/public/bible/*/*.json"):
    if f.endswith(".gloss.json"):
        continue
    d = json.load(open(f))
    for v in d["verses"]:
        toks = [clean(t) for la, _ in v["pairs"] for t in la.split()]
        toks = [t for t in toks if t]
        freq.update(toks)
        bigrams.update(zip(toks, toks[1:]))

